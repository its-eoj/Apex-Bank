<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="25.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.mycompany.oopproject.PrimaryController" style="-fx-background-color: #111827;">
   <padding>
      <Insets top="40.0" left="40.0" right="40.0" bottom="40.0"/>
   </padding>
   <children>
      
      <Label text="Apex Bank" textFill="WHITE">
         <font>
            <Font name="System Bold" size="36.0" />
         </font>
      </Label>
      
      <Label text="Sign in to your secure portal" textFill="#9ca3af">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      
      <TextField fx:id="emailField" maxWidth="340.0" promptText="Email Address (@... .com)" style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 5;" prefHeight="42.0">
         <font>
            <Font size="14.0" />
         </font>
      </TextField>
      
      <PasswordField fx:id="passwordField" maxWidth="340.0" promptText="Password" style="-fx-background-color: #1f2937; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-background-radius: 5;" prefHeight="42.0">
         <font>
            <Font size="14.0" />
         </font>
      </PasswordField>
      
      <Label fx:id="statusLabel" textFill="#e74c3c" wrapText="true" alignment="CENTER">
         <font>
            <Font name="System Semibold" size="13.0" />
         </font>
      </Label>
      
      <Button text="Sign In" onAction="#handleLoginButtonAction" maxWidth="340.0" prefWidth="340.0" prefHeight="42.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5; -fx-cursor: hand;" />
      
      <Button text="Create an account" onAction="#handleRegisterView" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-underline: true; -fx-cursor: hand; -fx-padding: 0;" />
      
   </children>
</VBox>
