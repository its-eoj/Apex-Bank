<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.mycompany.oopproject.PrimaryController">
   <children>
      
      <VBox prefWidth="200.0" styleClass="sidebar">
         <children>
            <Label text="Apex Bank" styleClass="sidebar-title" />
            <Label text="Dashboard" styleClass="sidebar-heading" style="-fx-text-fill: #888888; -fx-font-size: 14px; -fx-padding: 10 0 5 15; -fx-font-weight: bold;" />
            <Button maxWidth="Infinity" text="Transfer Money" styleClass="nav-button" onAction="#handleTransferMoneyView"  />
            <Button maxWidth="Infinity" text="Transaction History" styleClass="nav-button" onAction="#handleTransactionHistoryView" />
            <Button maxWidth="Infinity" text="Log Out" styleClass="nav-button"  onAction="#handleLogOut" />
         </children>
      </VBox>
      
      
      <VBox HBox.hgrow="ALWAYS" styleClass="dashboard-panel">
         <children>
            
            <Label text="Welcome Back, User!" styleClass="welcome-header" />
            
            <VBox prefHeight="100.0" styleClass="balance-card">
               <children>
                  <Label text="TOTAL AVAILABLE BALANCE" styleClass="balance-label" />
                  <Label text="\$0.0" styleClass="balance-amount" />
               </children>
            </VBox>
            
            <Label text="Quick Actions" styleClass="section-header" />
            
            <HBox spacing="15.0">
               <children>
                  <Button text="Deposit" styleClass="btn-deposit" onAction="#handleDepositView" />
                  <Button text="Withdraw" styleClass="btn-withdraw" onAction="#handleWithdrawView" />
               </children>
            </HBox>
            
         </children>
      </VBox>

   </children>
</HBox>